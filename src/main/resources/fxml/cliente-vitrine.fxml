<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.salgaderia.app.util.PixPainel?>
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salgaderia.app.controller.ClienteVitrineController" stylesheets="@../css/cliente-vitrine.css" styleClass="vitrine-page">
    <top>
        <VBox spacing="16" styleClass="vitrine-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Vitrine de pedidos" styleClass="vitrine-titulo" />
                    <Label fx:id="saudacao" styleClass="subtitle" />
                    <Label fx:id="statusLoja" text="Consultando horário da loja…" wrapText="true" styleClass="estado-vitrine" />
                </VBox>
                <Button fx:id="botaoCatalogo" text="Cardápio" onAction="#mostrarVitrine" styleClass="button-outline" />
                <Button fx:id="botaoPedidos" text="Meus Pedidos" onAction="#mostrarPedidos" styleClass="button-secondary" />
                <Button fx:id="botaoClube" text="Clube VIP" onAction="#mostrarClube" styleClass="button-secondary" />
                <Button fx:id="pedirDeSempre" text="Pedir o de Sempre (2 Cliques)" onAction="#pedirDeSempre" styleClass="button-secondary" />
                <Button text="Sair" onAction="#sair" styleClass="button-outline" />
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="busca" promptText="Busque pelo nome ou sabor" accessibleText="Buscar por nome ou sabor" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="categorias" prefWidth="220" promptText="Todas as categorias" accessibleText="Filtro de categoria" />
                <Button fx:id="botaoPerfil" text="Meu perfil" onAction="#meuPerfil" styleClass="button-outline" />
                <Button text="Atualizar" onAction="#carregarProdutos" styleClass="button-outline" />
            </HBox>
            <Label fx:id="cupomUrgente" wrapText="true" managed="false" visible="false" styleClass="estado-vitrine" />
        </VBox>
    </top>
    <center>
        <StackPane styleClass="conteudo-vitrine">
            <VBox fx:id="painelVitrine" spacing="12">
                <Label text="Escolha seus favoritos" styleClass="secao-titulo" />
                <ScrollPane fx:id="rolagemProdutos" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="rolagem-transparente">
                    <content>
                        <VBox spacing="12">
                            <FlowPane hgap="8" vgap="8">
                                <Button fx:id="montarCombo" text="Monte seu Combo" onAction="#montarCombo" styleClass="button-secondary" />
                                <Button fx:id="caixaMisteriosa" text="Caixa Misteriosa Ui K'Fomi" onAction="#caixaMisteriosa" styleClass="button-secondary" />
                            </FlowPane>
                            <Label fx:id="mensagemProdutos" wrapText="true" styleClass="estado-vitrine" />
                            <FlowPane fx:id="cards" hgap="14" vgap="14" />
                            <Separator />
                            <Label text="Fotos de quem já provou" styleClass="secao-titulo" />
                            <Label fx:id="mensagemFotos" text="Carregando fotos de avaliações…" wrapText="true" styleClass="subtitle" />
                            <FlowPane fx:id="galeriaFotos" hgap="12" vgap="12" />
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
            <VBox fx:id="painelPedidos" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Meus pedidos" styleClass="secao-titulo" HBox.hgrow="ALWAYS" />
                    <Button text="Atualizar pedidos" onAction="#carregarPedidos" styleClass="button-outline" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="rolagem-transparente">
                    <content>
                        <VBox spacing="12">
                            <Label fx:id="mensagemPedidos" wrapText="true" styleClass="estado-vitrine" />
                            <VBox fx:id="listaPedidos" spacing="12" />
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
            <VBox fx:id="painelClube" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Clube VIP Ui K'Fomi" styleClass="secao-titulo" HBox.hgrow="ALWAYS" />
                    <Button text="Atualizar clube" onAction="#mostrarClube" styleClass="button-outline" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="rolagem-transparente">
                    <content><VBox fx:id="conteudoClube" spacing="12" /></content>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
    <right>
        <ScrollPane prefWidth="315" minWidth="280" hbarPolicy="NEVER" fitToWidth="true" styleClass="rolagem-transparente">
            <content><VBox spacing="12" styleClass="painel-carrinho">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Seu carrinho" styleClass="secao-titulo" HBox.hgrow="ALWAYS" />
                <Label fx:id="contador" styleClass="subtitle" />
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="140" styleClass="rolagem-transparente">
                <content><VBox fx:id="itensCarrinho" spacing="8" /></content>
            </ScrollPane>
            <Separator />
            <Label text="Como deseja receber?" styleClass="field-label" />
            <RadioButton fx:id="retirada" text="Retirada no Balcão" />
            <RadioButton fx:id="entrega" text="Entrega" />
            <RadioButton fx:id="local" text="Consumir no Local" />
            <Label fx:id="endereco" wrapText="true" styleClass="subtitle" />
            <VBox fx:id="selecaoBairro" spacing="5" visible="false" managed="false">
                <Label text="Bairro de entrega" styleClass="field-label" />
                <ComboBox fx:id="bairroEntrega" promptText="Selecione o bairro" maxWidth="Infinity" />
            </VBox>
            <CheckBox fx:id="agendar" text="Agendar para Evento/Festa" />
            <DatePicker fx:id="dataAgendamento" promptText="Data do evento" />
            <TextField fx:id="horaAgendamento" promptText="Horário (HH:mm)" />
            <Separator />
            <Label text="Forma de pagamento" styleClass="field-label" />
            <ComboBox fx:id="formaPagamento" promptText="Selecione a forma de pagamento" maxWidth="Infinity" />
            <VBox fx:id="dadosPagadorPix" spacing="5" visible="false" managed="false">
                <Label text="Dados para a cobrança Mercado Pago" wrapText="true" styleClass="field-label" />
                <TextField fx:id="emailPix" promptText="E-mail do pagador" />
                <TextField fx:id="documentoPix" promptText="CPF ou CNPJ do pagador" />
            </VBox>
            <Label text="Cupom de desconto" styleClass="field-label" />
            <TextField fx:id="cupom" promptText="Código do cupom (opcional)" />
            <Label fx:id="mensagemDesconto" wrapText="true" styleClass="subtitle" />
            <Label fx:id="mensagemMinimo" wrapText="true" styleClass="estoque-esgotado" managed="false" visible="false" />
            <Label fx:id="mensagemFrete" wrapText="true" styleClass="subtitle" managed="false" visible="false" />
            <HBox alignment="CENTER_LEFT"><Label text="Total" HBox.hgrow="ALWAYS" styleClass="field-label" /><Label fx:id="total" styleClass="produto-preco" /></HBox>
            <Label fx:id="orientacaoLoja" wrapText="true" managed="false" visible="false" styleClass="subtitle" />
            <Button fx:id="finalizar" text="Finalizar Pedido" maxWidth="Infinity" onAction="#finalizar" styleClass="button-primary" />
            <PixPainel fx:id="pixCheckout" />
            </VBox></content>
        </ScrollPane>
    </right>
</BorderPane>
